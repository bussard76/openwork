                  "type": "text",
                  "id": "ViLm4",
                  "name": "mdBody2",
                  "fill": "#3A3A3A",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "• Keep things in one function unless composable or reusable\n• Avoid try/catch where possible\n• Avoid using the any type\n• Prefer single word variable names where possible\n• Use Bun APIs when possible, like Bun.file()\n• Rely on type inference when possible",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "unpEA",
                  "name": "mdH3b",
                  "fill": "#1A1A1A",
                  "content": "Naming",
                  "fontFamily": "Inter",
                  "fontSize": 13,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "sdbKQ",
                  "name": "mdBody3",
                  "fill": "#3A3A3A",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Prefer single word names for variables and functions. Only use multiple words if necessary.",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "Ocu4w",
                  "name": "codeBlock",
                  "width": "fill_container",
                  "fill": "#EDEAE4",
                  "cornerRadius": 6,
                  "layout": "vertical",
                  "gap": 4,
                  "padding": [
                    12,
                    14
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "6sFP5",
                      "name": "codeLine1",
                      "fill": "#9A9490",
                      "content": "// Good",
                      "fontFamily": "Courier New",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "ShJnk",
                      "name": "codeLine2",
                      "fill": "#1A1A1A",
                      "content": "const foo = 1",
                      "fontFamily": "Courier New",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "v7ZYE",
                      "name": "codeLine3",
                      "fill": "#1A1A1A",
                      "content": "function journal(dir: string) {}",
                      "fontFamily": "Courier New",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "qtSXv",
                      "name": "codeLine4",
                      "fill": "#9A9490",
                      "content": "// Bad",
                      "fontFamily": "Courier New",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "KaqQH",
                      "name": "codeLine5",
                      "fill": "#C0392B",
                      "content": "const fooBar = 1",
                      "fontFamily": "Courier New",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "QTHzm",
                      "name": "codeLine6",
                      "fill": "#C0392B",
                      "content": "function prepareJournal(dir: string) {}",
                      "fontFamily": "Courier New",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "rbEhb",
                  "name": "mdH3c",
                  "fill": "#1A1A1A",
                  "content": "Variables",
                  "fontFamily": "Inter",
                  "fontSize": 13,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "Q8G6M",
                  "name": "mdBody4",
                  "fill": "#3A3A3A",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Prefer const over let. Use ternaries or early returns instead of reassignment.",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "7btrI",
                  "name": "mdH2c",
                  "fill": "#1A1A1A",
                  "content": "Testing",
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "YmSwP",
                  "name": "mdBody5",
                  "fill": "#3A3A3A",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "• Avoid mocks as much as possible\n• Test actual implementation, do not duplicate logic into tests\n• Tests cannot run from repo root; run from package dirs like packages/opencode.",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
    },
