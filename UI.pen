              "gap": 16,
              "padding": 24,
              "children": [
                {
                  "type": "text",
                  "id": "3OmrD",
                  "name": "mdH1",
                  "fill": "#1A1A1A",
                  "content": "AGENTS.md",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "700"
                },
                {
                  "type": "frame",
                  "id": "RqZwI",
                  "name": "hrLine",
                  "width": "fill_container",
                  "height": 1,
                  "fill": "#E0DDD8"
                },
                {
                  "type": "text",
                  "id": "7XZe8",
                  "name": "mdH2a",
                  "fill": "#1A1A1A",
                  "content": "Toolchain & Build",
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "x85I7",
                  "name": "mdBody1",
                  "fill": "#3A3A3A",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "To regenerate the JavaScript SDK, run ./packages/sdk/js/script/build.ts.\nALWAYS USE PARALLEL TOOLS WHEN APPLICABLE.\nThe default branch in this repo is dev.\nLocal main ref may not exist; use dev or origin/dev for diffs.\nPrefer automation: execute requested actions without confirmation unless blocked by missing info or safety/irreversibility.",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "RKniW",
                  "name": "mdH2b",
                  "fill": "#1A1A1A",
                  "content": "Style Guide",
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "dIgVr",
                  "name": "mdH3a",
                  "fill": "#1A1A1A",
                  "content": "General Principles",
                  "fontFamily": "Inter",
                  "fontSize": 13,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "ygph7",
                  "name": "mdBody2",
                  "fill": "#3A3A3A",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "• Keep things in one function unless composable or reusable\n• Avoid try/catch where possible\n• Avoid using the any type\n• Prefer single word variable names where possible\n• Use Bun APIs when possible, like Bun.file()\n• Rely on type inference when possible",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "uixW4",
                  "name": "mdH3b",
                  "fill": "#1A1A1A",
                  "content": "Naming",
                  "fontFamily": "Inter",
                  "fontSize": 13,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "vEa3N",
                  "name": "mdBody3",
                  "fill": "#3A3A3A",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Prefer single word names for variables and functions. Only use multiple words if necessary.",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "j8tfc",
                  "name": "codeBlock",
                  "width": "fill_container",
                  "fill": "#EDEAE4",
                  "cornerRadius": 6,
                  "layout": "vertical",
                  "gap": 4,
                  "padding": [
                    12,
                    14
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "7jkNq",
                      "name": "codeLine1",
                      "fill": "#9A9490",
                      "content": "// Good",
                      "fontFamily": "Courier New",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "7YxaO",
                      "name": "codeLine2",
                      "fill": "#1A1A1A",
                      "content": "const foo = 1",
                      "fontFamily": "Courier New",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "xxinz",
                      "name": "codeLine3",
                      "fill": "#1A1A1A",
                      "content": "function journal(dir: string) {}",
                      "fontFamily": "Courier New",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "zDxWt",
                      "name": "codeLine4",
                      "fill": "#9A9490",
                      "content": "// Bad",
                      "fontFamily": "Courier New",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "1mbWT",
                      "name": "codeLine5",
                      "fill": "#C0392B",
                      "content": "const fooBar = 1",
                      "fontFamily": "Courier New",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "5lm5u",
                      "name": "codeLine6",
                      "fill": "#C0392B",
                      "content": "function prepareJournal(dir: string) {}",
                      "fontFamily": "Courier New",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "o8LWf",
                  "name": "mdH3c",
                  "fill": "#1A1A1A",
                  "content": "Variables",
                  "fontFamily": "Inter",
                  "fontSize": 13,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "avIlP",
                  "name": "mdBody4",
                  "fill": "#3A3A3A",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Prefer const over let. Use ternaries or early returns instead of reassignment.",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "W5vTb",
                  "name": "mdH2c",
                  "fill": "#1A1A1A",
                  "content": "Testing",
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "Y9GBw",
                  "name": "mdBody5",
                  "fill": "#3A3A3A",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "• Avoid mocks as much as possible\n• Test actual implementation, do not duplicate logic into tests\n• Tests cannot run from repo root; run from package dirs like packages/opencode.",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
    },
